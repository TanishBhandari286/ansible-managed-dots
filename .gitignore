# =============================================================================
# .gitignore — Dotfiles Repository
# =============================================================================

# --- Ansible secrets ---------------------------------------------------------
# NEVER commit the vault password file or any unencrypted private keys
ansible/.vault_pass
*.vault_pass

# --- SSH private keys — Ansible Vault-encrypted, tracked in git --------------
# `id_*` (no extension) = vault ciphertext → committed. `.pub` = public → committed.
# (Legacy sops `.enc` files removed — vault is now the single secret system.)
ssh_keys/id_*
!ssh_keys/id_*.pub

# --- Ansible runtime artifacts -----------------------------------------------
ansible/*.retry
ansible/.cache/
ansible/fact_cache/

# --- macOS artifacts ---------------------------------------------------------
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride

# --- Editors -----------------------------------------------------------------
*.swp
*.swo
*~
.idea/
.vscode/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.env
.venv/
result
