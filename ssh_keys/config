# Shared hosts live below. Personal (machine-local) overrides go in
# ~/.ssh/config.dots-local, which is INCLUDED here — keep only deltas there,
# never duplicate the Host blocks defined in this file.
Include ~/.ssh/config.dots-local

Host *
    IdentitiesOnly yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
    SetEnv TERM=xterm-256color

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_ansible

Host vps
    HostName 69.62.77.27
    User vps
    Port 2222
    IdentityFile ~/.ssh/id_ed25519_ansible

Host master-node
    HostName 192.168.29.22
    User master-node
    IdentityFile ~/.ssh/id_ed25519_ansible

Host cp
    HostName 192.168.29.10
    User cp
    IdentityFile ~/.ssh/id_ed25519_ansible

Host dp
    HostName 192.168.29.11
    User dp
    IdentityFile ~/.ssh/id_ed25519_ansible

